<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <RootNamespace>Apache.Cosmos.Sample</RootNamespace>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Apache.Calcite.Cosmos.Adapter\Apache.Calcite.Cosmos.Adapter.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Apache.Calcite.Data" Version="2.0.1-pre.96" />
        <PackageReference Include="Spectre.Console" Version="0.57.2" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="IKVM" Version="8.16.0" />
        <PackageReference Include="IKVM.Java.Extensions" Version="8.16.0" />
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.1" />
        <MavenReference Include="org.apache.calcite:calcite-csv" Version="1.42.0" />
    </ItemGroup>

</Project>
