<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <Description>Apache Calcite adapter that plans queries against Azure Cosmos DB by generating Cosmos SQL.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>apache;calcite;cosmos;cosmosdb;azure;adapter;sql;ikvm</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.0" />
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="IKVM" Version="8.16.1" />
        <PackageReference Include="IKVM.Java.Extensions" Version="8.16.1" />
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.1" />
        <PackageReference Include="Apache.Calcite.Extensions" Version="2.0.1-pre.188" />
        <PackageReference Include="Apache.Calcite.FullText" Version="2.0.1-pre.188" />
        <PackageReference Include="Apache.Calcite.Geography" Version="2.0.1-pre.188" />
        <MavenReference Include="org.apache.commons:commons-lang3" Version="3.18.0" />
        <MavenReference Include="com.fasterxml.jackson.core:jackson-annotations" Version="2.22" />
        <MavenReference Include="org.apache.calcite:calcite-core" Version="1.42.0">
            <Dependencies>
                com.jayway.jsonpath:json-path/com.fasterxml.jackson.core:jackson-databind:2.22.2,optional=true;
                com.jayway.jsonpath:json-path/com.fasterxml.jackson.core:jackson-core:2.22.2,optional=true
            </Dependencies>
        </MavenReference>
        <MavenReference Include="org.jooq:joou-java-6" Version="0.9.5" />
        <MavenReference Include="com.networknt:json-schema-validator" Version="1.5.9" />
    </ItemGroup>

</Project>
