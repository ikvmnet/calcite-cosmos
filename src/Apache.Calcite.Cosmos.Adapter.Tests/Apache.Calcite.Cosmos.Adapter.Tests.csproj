<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
        <!-- xunit.v3 builds the assembly as its own runner, and writes the entry point itself. -->
        <OutputType>Exe</OutputType>
        <GenerateProgramFile>false</GenerateProgramFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="IKVM" Version="8.16.1" />
        <PackageReference Include="IKVM.Java.Extensions" Version="8.16.1" />
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.1" />
        <PackageReference Include="FluentAssertions" Version="8.11.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="xunit.v3" Version="4.0.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
        <PackageReference Include="Apache.Calcite.Data" Version="2.0.1-pre.188" />
        <PackageReference Include="Apache.Calcite.FullText" Version="2.0.1-pre.188" />
        <PackageReference Include="Apache.Calcite.Geography" Version="2.0.1-pre.188" />
        <PackageReference Include="Testcontainers" Version="4.15.0" />
    </ItemGroup>

    <ItemGroup>
        <MavenReference Include="org.apache.commons:commons-lang3" Version="3.18.0" />
        <MavenReference Include="com.fasterxml.jackson.core:jackson-annotations" Version="2.22" />
        <MavenReference Include="org.apache.calcite:calcite-core" Version="1.42.0">
            <Dependencies>
                com.jayway.jsonpath:json-path/com.fasterxml.jackson.core:jackson-databind:2.22.2,optional=true;
                com.jayway.jsonpath:json-path/com.fasterxml.jackson.core:jackson-core:2.22.2,optional=true
            </Dependencies>
        </MavenReference>
        <MavenReference Include="org.apache.calcite.avatica:avatica-core" Version="1.29.0" />
        <MavenReference Include="com.networknt:json-schema-validator" Version="1.5.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Apache.Calcite.Cosmos.Adapter\Apache.Calcite.Cosmos.Adapter.csproj" />
    </ItemGroup>

</Project>
