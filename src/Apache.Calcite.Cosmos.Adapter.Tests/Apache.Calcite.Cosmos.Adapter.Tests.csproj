<Project Sdk="MSTest.Sdk/4.4.0">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="IKVM" Version="8.16.0" />
        <PackageReference Include="IKVM.Java.Extensions" Version="8.16.0" />
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.1" />
        <PackageReference Include="FluentAssertions" Version="8.10.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="Apache.Calcite.Data" Version="2.0.1-pre.96" />
        <PackageReference Include="Apache.Calcite.Geography" Version="2.0.1-pre.96" />
        <PackageReference Include="Testcontainers" Version="4.15.0" />
    </ItemGroup>

    <ItemGroup>
        <MavenReference Include="org.apache.calcite:calcite-core" Version="1.42.0" />
        <MavenReference Include="org.apache.calcite.avatica:avatica-core" Version="1.28.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Apache.Calcite.Cosmos.Adapter\Apache.Calcite.Cosmos.Adapter.csproj" />
    </ItemGroup>

</Project>
