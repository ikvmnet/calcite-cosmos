<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <Optimize>true</Optimize>
        <TieredPGO>true</TieredPGO>
        <ServerGarbageCollector>false</ServerGarbageCollector>
    </PropertyGroup>

    <ItemGroup>
        <!-- The adapter's fact layer, compiled as it is: it references nothing but the base library. -->
        <Compile Include="../../src/Apache.Calcite.Cosmos.Adapter/Facts/*.cs" Link="Facts/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Eggnog" Version="0.0.1-pre.46" />
    </ItemGroup>

</Project>
