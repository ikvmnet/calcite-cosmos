<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!-- Eggnog is on nuget.org; the organization feed the repository's own nuget.config adds needs credentials. -->
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>
</configuration>
